    "enableTimeWindows": {
      "default": true,
      "title": "Enabletimewindows",
      "type": "boolean"
    },
    "destCountryCode3": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destcountrycode3"
    },
    "distanceLessThanFirstLeg": {
      "default": false,
      "title": "Distancelessthanfirstleg",
      "type": "boolean"
    },
    "dnSiteVoList": {
      "items": {
        "$ref": "#/$defs/DN"
      },
