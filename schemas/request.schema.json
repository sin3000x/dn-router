{
  "$defs": {
    "DN": {
      "properties": {
        "orderReleaseId": {
          "title": "Orderreleaseid",
          "type": "string"
        },
        "siteCode": {
          "title": "Sitecode",
          "type": "string"
        },
        "deliveryLatitude": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Deliverylatitude"
        },
        "deliveryLongitude": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Deliverylongitude"
        },
        "totalGrossVolume": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Totalgrossvolume"
        },
        "totalGrossWeight": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Totalgrossweight"
        },
        "timeWindow": {
          "anyOf": [
            {
              "items": {
                "format": "date-time",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timewindow"
        }
      },
      "required": [
        "orderReleaseId",
        "siteCode",
        "deliveryLatitude",
        "deliveryLongitude",
        "totalGrossVolume",
        "totalGrossWeight"
