      "type": "integer"
    },
    "quotationModel": {
      "anyOf": [
        {
          "enum": [
            "distance",
            "city",
            "zipCode",
            "province",
            ""
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quotationmodel"
    },
    "siteDistanceLimit": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
