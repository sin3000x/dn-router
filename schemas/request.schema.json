    "sourceLatitude": {
      "anyOf": [
        {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Sourcelatitude"
    },
    "sourceLongitude": {
      "anyOf": [
        {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Sourcelongitude"
    },
    "sourceLocation": {
      "title": "Sourcelocation",
      "type": "string"
    },
    "taskNo": {
      "default": "",
      "title": "Taskno",
      "type": "string"
    },
    "vehicleTypeVoList": {
      "items": {
        "$ref": "#/$defs/Vehicle"
      },
      "minItems": 1,
      "title": "Vehicletypevolist",
      "type": "array"
